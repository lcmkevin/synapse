{
  "name": "synapse-cli",
  "displayName": "Synapse",
  "version": "0.1.6",
  "private": false,
  "description": "Synapse - Intelligent rule orchestration for AI-powered development",
  "publisher": "labs-synapse",
  "license": "MIT",
  "bin": {
    "synapse": "./bin/synapse-unified.js"
  },
  "main": "./src/core.js",
  "exports": {
    ".": "./src/core.js",
    "./cli": "./bin/synapse-unified.js"
  },
  "files": [
    "bin/",
    "standalone/",
    "website/",
    "src/",
    "public/",
    "api/",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "node -e \"process.exit(process.env.VERCEL ? 0 : 1)\" || (npm --prefix ./standalone install --ignore-scripts && npm --prefix ./standalone run build)",
    "postinstall": "node -e \"process.exit(process.env.VERCEL ? 0 : 1)\" || npm run build",
    "prepublishOnly": "npm run build",
    "build:binary": "pkg . --targets node18-win-x64,node18-win-arm64,node18-macos-x64,node18-macos-arm64,node18-linux-x64,node18-linux-arm64 --out-path dist",
    "build:binary:win": "pkg . --targets node18-win-x64 --out-path dist",
    "build:binary:mac": "pkg . --targets node18-macos-x64,node18-macos-arm64 --out-path dist",
    "build:binary:linux": "pkg . --targets node18-linux-x64,node18-linux-arm64 --out-path dist",
    "build:all": "npm run build:binary",
    "release:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-release-assets.ps1",
    "dashboard": "node ./src/server.js",
    "website:dev": "cd website && python -m http.server 3000",
    "website:build": "node -e \"require('fs-extra').removeSync('dist/website'); require('fs-extra').copySync('website','dist/website',{overwrite:true});\""
  },
  "engines": {
    "node": ">=16.17.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "chokidar": "^3.5.0",
    "commander": "^11.0.0",
    "express": "^4.18.0",
    "fs-extra": "^11.0.0",
    "nodemailer": "^6.9.16",
    "semver": "^7.7.1",
    "tiktoken": "^1.0.22",
    "undici": "^5.28.4",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.7.0",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "bin/synapse-unified.js",
      "src/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "Template/**/*"
    ],
    "outputPath": "dist"
  }
}
